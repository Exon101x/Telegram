# Copy this file to .env and fill in your own values.
# Get API_ID / API_HASH from https://my.telegram.org/apps — the same pair
# works for both the Pyrogram and Telethon backends, since it identifies a
# Telegram "application", not a library.

API_ID=
API_HASH=

# Only needed for bot-account sessions / running telegram_session_bot.py
# (from @BotFather)
BOT_TOKEN=

# Only used by telegram_session_bot.py — comma-separated Telegram user IDs
# allowed to use /generate. Leave blank to allow anyone who messages the
# bot (not recommended outside personal/local testing).
ALLOWED_USER_IDS=

# Optional, used by generate_session.py / validate_session.py / the bot if
# --proxy isn't passed explicitly.
PROXY=
